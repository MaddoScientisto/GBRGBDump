<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>GBTools.ImageSharp.GameBoyCamera</PackageId>
    <Title>GBTools.ImageSharp.GameBoyCamera</Title>
    <Description>ImageSharp integration and compatibility scaffolding for Game Boy Camera images.</Description>
    <Authors>GBRGBDump</Authors>
    <PackageTags>gameboy;game-boy;camera;imagesharp;decoder;encoder</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

</Project>

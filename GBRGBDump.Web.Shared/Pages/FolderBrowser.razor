@page "/folders"
@using GBRGBDump.Web.Shared.Services.Impl
@inject ISettingsService SettingsService
@inject NavigationManager Navigation
@inject GBRGBDump.Web.Shared.Services.IFileSystemService FileSystemService

<Button Clicked="ShowPreview" Color="Color.Primary">Preview</Button>
<Button Clicked="OpenGallery" Color="Color.Primary">Open Gallery</Button>

<span>Toast visible: @PreviewVisible</span>

<Toaster>
    <Toast @bind-Visible="ShowModal" Autohide="false">
        <ToastHeader>
            <Strong>Asdf</Strong>
            <CloseButton />
        </ToastHeader>
        
        <ToastBody>
            @if (PreviewVisible)
            {
                <ImagePreview Path="@selectedNode?.Path"></ImagePreview>
            }
        </ToastBody>
    </Toast>
</Toaster>

@* @if (showPreview && !string.IsNullOrWhiteSpace(selectedNode?.Text) && selectedNode.Type == ItemType.Image)
{



    <ImagePreview Path="@selectedNode?.Path"></ImagePreview>

}
 *@

<TreeView Nodes="Items"
          GetChildNodes="@(item => item.Children)"
          HasChildNodes="@(item => item.Children?.Any() == true)"
          @bind-SelectedNode="selectedNode"
          @bind-ExpandedNodes="expandedNodes">
    <NodeContent>
        @switch (context.Type)
        {
            case ItemType.File:
                <Icon Name="IconName.File"/>
                break;
            case ItemType.Image:
                <Icon Name="IconName.Image"/>
                @* <div>
                    <Figure Size="FigureSize.Is16x16">
                        <FigureImage Source=""></FigureImage>
                    </Figure>
                </div> *@
                break;
            case ItemType.Rom:
                <Icon Name="IconName.Gamepad"/>
                break;
            case ItemType.Sav:
                <Icon Name="IconName.CompactDisc"/>
                break;
            case ItemType.Folder:
                <Icon Name="IconName.Folder"/>
                break;
            default:
                <Icon Name="IconName.File"/>
                break;
        }
        @context.Text
    </NodeContent>
</TreeView>

@code {

    [Inject] public IModalService ModalService { get; set; }
    [Inject] IMessageService MessageService { get; set; }

    private SettingsModel? Settings { get; set; }

    protected override void OnInitialized()
    {
        Settings ??= SettingsService.LoadSettings() ?? new()
        {
            // Set defaults here
            ChannelOrder = ChannelOrder.Sequential,
            AverageType = AverageTypes.Normal
        };

        if (string.IsNullOrWhiteSpace(Settings.OutputPath))
        {
            return;
        }

        var fileSystem = FileSystemService.GetFileSystemEntries(Settings.OutputPath);

        var builder = new PathToHierarchy();
        var root = builder.BuildHierarchy(fileSystem.ToList());

        Items = [root];
    }


    IEnumerable<Item> Items = new[]
    {
        new Item { Text = "Test" }
    };

    IList<Item> expandedNodes = new List<Item>();
    Item? selectedNode = null;


    bool ShowModal { get; set; } = false;

    bool showPreview = false;

    bool PreviewVisible
    {
        get => showPreview && selectedNode != null && !string.IsNullOrWhiteSpace(selectedNode?.Text) && selectedNode.Type == ItemType.Image;
        set => showPreview = value;
    }

    void ShowPreview()
    {
        ShowModal = true;
        showPreview = true;
    }

    private async Task OpenGallery()
    {

        try
        {
            // TODO: Load images and pass them to the modal

            if (selectedNode == null) return;
            if (selectedNode.Type != ItemType.Folder) return;

            var path = selectedNode.Path;

            var fileSystem = FileSystemService.GetFileSystemEntries(path);

            var imagePaths = fileSystem.Where(x => x.EndsWith(".png")).ToList();

            ObservableCollection<GbImageContainer> _images = [];

            foreach (var imagePath in imagePaths)
            {
                var img = await FileSystemService.ImageToGbImageAsync(imagePath);

                _images.Add(img);
            }

            await ModalService.Show<GalleryModal>("Directory", _builder =>
            {
                _builder.Add(_modal => _modal.Model, Settings);
                _builder.Add(_modal => _modal.ImportType, ImportType.None);
                _builder.Add(_modal => _modal.Images, _images);
            }, new ModalInstanceOptions() { Size = ModalSize.Fullscreen });
        }
        catch (Exception e)
        {
            Console.WriteLine(e);
            await MessageService.Error(e.ToString());
        }

        

    }
}
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>GBTools.ImageSharp.GameBoyCamera.Lite</PackageId>
    <Title>GBTools.ImageSharp.GameBoyCamera.Lite</Title>
    <Description>Minimal Game Boy Camera bin decoder for ImageSharp.</Description>
    <Authors>GBRGBDump</Authors>
    <PackageTags>gameboy;game-boy;camera;imagesharp;decoder</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

</Project>
{
  "name": "picnrec-web-serial-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build:lib && npm run build:demo",
    "build:demo": "npm run build --workspace ./apps/test-app",
    "build:lib": "npm run build --workspace ./packages/picnrec-web-serial",
    "dev": "npm run dev --workspace ./apps/test-app",
    "lint": "npm run typecheck --workspace ./packages/picnrec-web-serial && npm run typecheck --workspace ./apps/test-app"
  },
  "devDependencies": {
    "@types/w3c-web-serial": "^1.0.6",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vite": "^5.4.21"
  }
}
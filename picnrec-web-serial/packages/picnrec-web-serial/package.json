{
  "name": "@maddoscientisto/picnrec-web-serial",
  "version": "0.1.0",
  "type": "module",
  "description": "Typed Web Serial client for the PicNRec protocol.",
  "repository": {
    "type": "git",
    "url": "https://github.com/MaddoScientisto/GBRGBDump.git",
    "directory": "picnrec-web-serial/packages/picnrec-web-serial"
  },
  "license": "MIT",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --project tsconfig.json"
  },
  "devDependencies": {
    "@types/w3c-web-serial": "^1.0.6",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "keywords": [
    "picnrec",
    "web-serial",
    "gameboy",
    "camera"
  ]
}
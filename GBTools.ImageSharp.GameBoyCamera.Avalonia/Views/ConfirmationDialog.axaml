<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GBTools.ImageSharp.GameBoyCamera.Avalonia.ViewModels"
        x:Class="GBTools.ImageSharp.GameBoyCamera.Avalonia.Views.ConfirmationDialog"
        x:DataType="vm:ConfirmationDialogViewModel"
        Width="460"
        Height="220"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Title}">
    <Grid RowDefinitions="*,Auto" Margin="20">
        <TextBlock Text="{Binding Message}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center" />

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,16,0,0">
            <Button Content="{Binding CancelText}" Command="{Binding CancelCommand}" MinWidth="90" />
            <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" MinWidth="110" />
        </StackPanel>
    </Grid>
</Window>
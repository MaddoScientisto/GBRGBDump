<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GBTools.ImageSharp.GameBoyCamera.Avalonia.ViewModels"
        xmlns:models="using:GBTools.ImageSharp.GameBoyCamera.Avalonia.Models"
        x:Class="GBTools.ImageSharp.GameBoyCamera.Avalonia.Views.GbxCartImportDialog"
        x:DataType="vm:GbxCartImportDialogViewModel"
        Width="760"
        Height="560"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Import From GBxCart">
    <Grid RowDefinitions="*,Auto" Margin="20">
        <StackPanel Spacing="14">
            <TextBlock Text="Choose how to import from the attached GBxCart device."
                       FontSize="16"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding PortSummary}"
                       TextWrapping="Wrap"
                       Opacity="0.82" />

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#FFD8A7A7"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasError}" />

            <StackPanel Spacing="8">
                <TextBlock Text="Serial port"
                           FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding AvailablePorts}"
                          SelectedItem="{Binding SelectedPort, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:GbxCartPortOption">
                            <StackPanel Spacing="2" Margin="0,4">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Details}"
                                           FontSize="12"
                                           Opacity="0.78"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Dump mode"
                           FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding AvailableModes}"
                          SelectedItem="{Binding SelectedMode, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Text="Decode options"
                           FontWeight="SemiBold" />
                <CheckBox Content="Ignore deleted photos"
                          IsChecked="{Binding IgnoreDeletedPhotos, Mode=TwoWay}" />
                <CheckBox Content="Ignore last-seen photo"
                          IsChecked="{Binding IgnoreLastSeenPhoto, Mode=TwoWay}" />
                <CheckBox Content="Accept bad dumps without Magic signature validation"
                          IsChecked="{Binding AcceptBadDumps, Mode=TwoWay}" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,16,0,0">
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    MinWidth="90" />
            <Button Content="Import"
                    Command="{Binding ConfirmCommand}"
                    MinWidth="100" />
        </StackPanel>
    </Grid>
</Window>
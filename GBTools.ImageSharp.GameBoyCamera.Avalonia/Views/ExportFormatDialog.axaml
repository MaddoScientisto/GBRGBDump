<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GBTools.ImageSharp.GameBoyCamera.Avalonia.ViewModels"
        x:Class="GBTools.ImageSharp.GameBoyCamera.Avalonia.Views.ExportFormatDialog"
        x:DataType="vm:ExportFormatDialogViewModel"
        Width="420"
        Height="360"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Choose Export Format">
    <Grid RowDefinitions="*,Auto" Margin="20">
        <StackPanel Spacing="10">
            <TextBlock Text="Select the format to export the chosen images to."
                       TextWrapping="Wrap"
                       Margin="0,0,0,6" />

            <StackPanel Spacing="8">
                <Button Content="Canonical Game Boy Camera (*.gbci)"
                        Command="{Binding ChooseCanonicalCommand}"
                        HorizontalAlignment="Stretch" />
                <Button Content="GB-BIN01 (*.bin)"
                        Command="{Binding ChooseGbBinCommand}"
                        HorizontalAlignment="Stretch" />
                <Button Content="GB-BIN01 base64 (*.b64)"
                    Command="{Binding ChooseGbBinBase64Command}"
                    HorizontalAlignment="Stretch" />
                <Button Content="gb-printer-web JSON (*.json)"
                        Command="{Binding ChooseJsonCommand}"
                        HorizontalAlignment="Stretch" />
                <Button Content="gb-printer-web TXT (*.txt)"
                    Command="{Binding ChooseTxtCommand}"
                    HorizontalAlignment="Stretch" />
                <Button Content="PNG image (*.png)"
                    Command="{Binding ChoosePngCommand}"
                    HorizontalAlignment="Stretch" />
            </StackPanel>

            <Border Margin="0,10,0,0"
                    Padding="10"
                    Background="#12000000"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel Spacing="6">
                    <CheckBox Content="For JSON export, combine all selected photos into a single file"
                              IsChecked="{Binding ExportSelectedToSingleFile, Mode=TwoWay}" />
                    <TextBlock Text="If unchecked, multi-photo exports use a folder and write one file per image."
                               TextWrapping="Wrap"
                               Opacity="0.75"
                               FontSize="12" />
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,16,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="90" />
        </StackPanel>
    </Grid>
</Window>
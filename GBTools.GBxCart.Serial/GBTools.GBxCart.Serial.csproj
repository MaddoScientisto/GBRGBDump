<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <AssemblyName>GBTools.GBxCart.Serial</AssemblyName>
    <RootNamespace>GBTools.GBxCart.Serial</RootNamespace>
    <PackageId>GBTools.GBxCart.Serial</PackageId>
    <Title>GBTools.GBxCart.Serial</Title>
    <Description>GBxCart serial client library for Game Boy Camera save and ROM dumping in GBRGBDump tools.</Description>
    <Authors>GBRGBDump</Authors>
    <PackageTags>gbxcart;serial;gameboy;camera;gbtools</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="RJCP.SerialPortStream" Version="3.0.5" />
  </ItemGroup>
</Project>